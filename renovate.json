{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["gradle", "gradle-wrapper"],
  "dependencyDashboard": true,
  "schedule": ["before 9am"],
  "timezone": "Asia/Shanghai",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchManagers": ["gradle-wrapper"],
      "groupName": "Gradle wrapper"
    },
    {
      "matchPackageNames": [
        "org.jetbrains.kotlin:kotlin-gradle-plugin",
        "com.google.devtools.ksp:com.google.devtools.ksp.gradle.plugin"
      ],
      "groupName": "Kotlin + KSP (co-dependent)",
      "commitMessageTopic": "Kotlin and KSP together"
    },
    {
      "matchPackageNames": [
        "org.jetbrains.kotlinx:kotlinx-coroutines-core",
        "org.jetbrains.kotlinx:kotlinx-coroutines-test"
      ],
      "groupName": "kotlinx-coroutines"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
