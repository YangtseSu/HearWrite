# Template for release signing — copy to `keystore.properties` (gitignored) and
# fill in real values. `storeFile` is resolved relative to the repo root.
#
# Generate a keystore once:
#   keytool -genkeypair -v -keystore hearwrite-release.jks -alias hearwrite \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# NEVER commit keystore.properties or the keystore file itself.
storeFile=hearwrite-release.jks
storePassword=CHANGE_ME
keyAlias=hearwrite
keyPassword=CHANGE_ME
